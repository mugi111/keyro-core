{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyro.dev/protocol/v0.3.0/core-studio.schema.json",
  "title": "Keyro Core-Studio Protocol v0.3",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/clientEnvelope" },
    { "$ref": "#/$defs/serverMessage" }
  ],
  "$defs": {
    "protocolVersion": {
      "type": "object",
      "required": ["major", "minor"],
      "additionalProperties": false,
      "properties": {
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "handshakeProtocolVersion": {
      "type": "object",
      "required": ["major", "minor"],
      "additionalProperties": false,
      "properties": {
        "major": { "const": 0 },
        "minor": { "const": 3 }
      }
    },
    "clientEnvelope": {
      "type": "object",
      "required": ["request_id", "message"],
      "additionalProperties": false,
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "message": { "$ref": "#/$defs/clientMessage" }
      }
    },
    "clientMessage": {
      "oneOf": [
        { "$ref": "#/$defs/handshake" },
        { "$ref": "#/$defs/getSnapshot" },
        { "$ref": "#/$defs/listProfiles" },
        { "$ref": "#/$defs/createProfile" },
        { "$ref": "#/$defs/renameProfile" },
        { "$ref": "#/$defs/setActiveProfile" },
        { "$ref": "#/$defs/saveAssignment" },
        { "$ref": "#/$defs/clearAssignment" },
        { "$ref": "#/$defs/virtualControlInput" }
      ]
    },
    "handshake": {
      "type": "object",
      "required": ["type", "component", "component_version", "protocol"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "handshake" },
        "component": { "const": "studio" },
        "component_version": { "type": "string", "minLength": 1 },
        "protocol": { "$ref": "#/$defs/handshakeProtocolVersion" }
      }
    },
    "getSnapshot": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "get_snapshot" }
      }
    },
    "listProfiles": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "list_profiles" }
      }
    },
    "createProfile": {
      "type": "object",
      "required": ["type", "name"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "create_profile" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "renameProfile": {
      "type": "object",
      "required": ["type", "profile_id", "name"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "rename_profile" },
        "profile_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "setActiveProfile": {
      "type": "object",
      "required": ["type", "profile_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "set_active_profile" },
        "profile_id": { "type": "string", "format": "uuid" }
      }
    },
    "saveAssignment": {
      "type": "object",
      "required": ["type", "assignment"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "save_assignment" },
        "assignment": { "$ref": "#/$defs/assignment" }
      }
    },
    "clearAssignment": {
      "type": "object",
      "required": ["type", "profile_id", "control"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "clear_assignment" },
        "profile_id": { "type": "string", "format": "uuid" },
        "control": { "$ref": "#/$defs/control" }
      }
    },
    "virtualControlInput": {
      "type": "object",
      "required": ["type", "control"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "virtual_control_input" },
        "control": { "$ref": "#/$defs/control" }
      }
    },
    "assignment": {
      "type": "object",
      "required": ["profile_id", "control", "action"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "format": "uuid" },
        "control": { "$ref": "#/$defs/control" },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "snapshotAssignment": {
      "type": "object",
      "required": ["profile_id", "control", "actions"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "format": "uuid" },
        "control": { "$ref": "#/$defs/control" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "control": {
      "oneOf": [
        { "$ref": "#/$defs/keyControl" },
        { "$ref": "#/$defs/encoderControl" }
      ]
    },
    "keyControl": {
      "type": "object",
      "required": ["kind", "page", "key"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "key" },
        "page": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "key": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "encoderControl": {
      "type": "object",
      "required": ["kind", "page", "encoder", "operation"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "encoder" },
        "page": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "encoder": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "operation": { "enum": ["left", "right", "press"] }
      }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/openUrlAction" }
      ]
    },
    "openUrlAction": {
      "type": "object",
      "required": ["kind", "url"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "open_url" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "name", "is_active"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "is_active": { "type": "boolean" }
      }
    },
    "deviceLayout": {
      "type": "object",
      "required": ["page_count", "key_rows", "key_columns", "encoder_count"],
      "additionalProperties": false,
      "properties": {
        "page_count": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "key_rows": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "key_columns": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "encoder_count": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "serverMessage": {
      "oneOf": [
        { "$ref": "#/$defs/handshakeAccepted" },
        { "$ref": "#/$defs/profiles" },
        { "$ref": "#/$defs/profileResponse" },
        { "$ref": "#/$defs/snapshot" },
        { "$ref": "#/$defs/acknowledged" },
        { "$ref": "#/$defs/actionEvent" },
        { "$ref": "#/$defs/error" }
      ]
    },
    "handshakeAccepted": {
      "type": "object",
      "required": ["type", "request_id", "core_version", "protocol"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "handshake_accepted" },
        "request_id": { "type": "string", "minLength": 1 },
        "core_version": { "type": "string", "minLength": 1 },
        "protocol": { "$ref": "#/$defs/handshakeProtocolVersion" }
      }
    },
    "profiles": {
      "type": "object",
      "required": ["type", "request_id", "profiles"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "profiles" },
        "request_id": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "profileResponse": {
      "type": "object",
      "required": ["type", "request_id", "profile"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "profile" },
        "request_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["type", "request_id", "layout", "profiles", "assignments"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "snapshot" },
        "request_id": { "type": "string", "minLength": 1 },
        "layout": { "$ref": "#/$defs/deviceLayout" },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "assignments": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshotAssignment" }
        }
      }
    },
    "acknowledged": {
      "type": "object",
      "required": ["type", "request_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "acknowledged" },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "actionEvent": {
      "type": "object",
      "required": ["type", "event"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "action_event" },
        "event": { "$ref": "#/$defs/actionEventPayload" }
      }
    },
    "actionEventPayload": {
      "oneOf": [
        { "$ref": "#/$defs/actionRunning" },
        { "$ref": "#/$defs/actionSucceeded" },
        { "$ref": "#/$defs/actionFailed" }
      ]
    },
    "actionRunning": {
      "type": "object",
      "required": ["state", "execution_id", "profile_id", "control"],
      "additionalProperties": false,
      "properties": {
        "state": { "const": "running" },
        "execution_id": { "type": "string", "format": "uuid" },
        "profile_id": { "type": "string", "format": "uuid" },
        "control": { "$ref": "#/$defs/control" }
      }
    },
    "actionSucceeded": {
      "type": "object",
      "required": ["state", "execution_id"],
      "additionalProperties": false,
      "properties": {
        "state": { "const": "succeeded" },
        "execution_id": { "type": "string", "format": "uuid" }
      }
    },
    "actionFailed": {
      "type": "object",
      "required": ["state", "execution_id", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "state": { "const": "failed" },
        "execution_id": { "type": "string", "format": "uuid" },
        "code": {
          "enum": [
            "open_url_failed",
            "no_action_assigned",
            "validation_failed",
            "internal"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "required": ["type", "request_id", "error"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "request_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "incompatible_protocol",
                "unknown_message",
                "validation_failed",
                "not_found",
                "internal"
              ]
            },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
